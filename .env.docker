# Docker Configuration
APP_PORT=80
WWWUSER=1000
WWWGROUP=1000
NODE_VERSION=22

# Xdebug
XDEBUG_MODE=develop,debug

# Database (PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=ai_news
DB_USERNAME=root
DB_PASSWORD=123456

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=123456

# Mail (Mailpit)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_DASHBOARD_PORT=8025

# Vite
VITE_PORT=5173

# pgAdmin
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=secret
